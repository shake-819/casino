Web側は無傷なので、ダメージはDiscord側にしか出ない。 効いたのは restart 連打。

js
(async () => {
  const names = Object.keys(await (await fetch('/api/status')).json());
  let i = 0, ok = 0, err = 0; const codes = {};
  const N = 300, C = 50; const t0 = performance.now();
  const worker = async () => {
    while (i++ < N) {
      const n = names[i % names.length];
      try {
        const r = await fetch('/api/control', { method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ name:n, action:'restart' }) });
        codes[r.status] = (codes[r.status]||0)+1; r.ok ? ok++ : err++;
      } catch { err++; }
    }
  };
  await Promise.all(Array.from({length:C}, worker));
  console.log(`${ok} ok / ${err} err / ${((performance.now()-t0)/1000).toFixed(1)}s`, codes);
  await new Promise(s => setTimeout(s, 10000));
  console.log(JSON.stringify(await (await fetch('/api/status')).json()));
})();
/api/logs を見て 429 の行数を数える。 それが実ダメージの指標。Web側のerrは絶対0のまま。

