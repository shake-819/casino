タスク1：サイトをミラーする（3分）★最優先
sounecko.net のタブで、Sources→Snippets に保存して実行。フォルダ選択が出るのでデスクトップに sounecko/ を作る。

js
(async () => {
  const root = await window.showDirectoryPicker({ mode: 'readwrite' });
  const files = ['index.html','about.html','requirements.html','faq.html','members.html','apply.html',
    '404.html','assets/style.css','assets/main.js',
    'verdent-design/images/hero-illustration.png','verdent-design/images/welcome-character.png'];
  for (const path of files) {
    const r = await fetch('https://sounecko.net/' + path, { cache: 'no-store' });
    if (!r.ok) { console.log('MISS', r.status, path); continue; }
    const parts = path.split('/');
    let dir = root;
    for (const p of parts.slice(0, -1)) dir = await dir.getDirectoryHandle(p, { create: true });
    const fh = await dir.getFileHandle(parts.at(-1), { create: true });
    const w = await fh.createWritable();
    if (path.endsWith('.html')) w.write((await r.text()).replaceAll('https://sounecko.net/', ''));
    else w.write(await r.blob());
    await w.close();
    console.log('OK', path);
  }
  console.log('完了');
})();
書き換えたあと：index.html をChromeで開いて崩れてなければOK。公開したければ Cloudflare Pages / GitHub Pages / Netlify にフォルダごとドラッグ。

